#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
# Hooks may run without HOME set, so derive the account home directory defensively.
HOME_DIR="${HOME:-$(eval echo "~$(id -un)")}"
SRC="$ROOT_DIR/AGENTS.local.md"
# Cursor reads guidance from the directory above the clone, so derive it instead of
# assuming the documented development-folder path.
DEV_DIR="$(dirname "$ROOT_DIR")"
MODE="${1:-sync}"

link_guidance() {
  dest="$1"
  surface="$2"

  if [ -L "$dest" ]; then
    target="$(readlink "$dest")"
    # Repoint links this repo owns; leave links into other sources alone.
    case "$target" in
      "$ROOT_DIR"/*) ln -sfn "$SRC" "$dest" ;;
      *) printf 'Skipping %s guidance: %s links outside this repo (%s)\n' "$surface" "$dest" "$target" >&2 ;;
    esac
    return 0
  fi

  if [ -e "$dest" ]; then
    # An empty placeholder carries no guidance and is safe to claim; anything with
    # content belongs to the user.
    if [ -s "$dest" ]; then
      printf 'Skipping %s guidance: %s is an existing non-empty file\n' "$surface" "$dest" >&2
      return 0
    fi
    rm -- "$dest"
  fi

  ln -s "$SRC" "$dest"
}

unlink_guidance() {
  dest="$1"
  [ -L "$dest" ] || return 0
  target="$(readlink "$dest")"
  case "$target" in
    "$ROOT_DIR"/*) rm -- "$dest" ;;
  esac
}

# Each surface is skipped when its home directory is absent, matching skill sync.
guidance_destinations() {
  # Cursor applies development-folder guidance to every repo underneath it. Skip the
  # account home itself so a clone directly in $HOME does not create ~/AGENTS.md.
  if [ "$DEV_DIR" != "$HOME_DIR" ]; then
    printf '%s\t%s\n' "$DEV_DIR/AGENTS.md" "Cursor"
  fi
  [ -d "$HOME_DIR/.codex" ] && printf '%s\t%s\n' "$HOME_DIR/.codex/AGENTS.md" "Codex"
  # Claude Code loads user-level guidance from CLAUDE.md and ignores AGENTS.md.
  [ -d "$HOME_DIR/.claude" ] && printf '%s\t%s\n' "$HOME_DIR/.claude/CLAUDE.md" "Claude Code"
  return 0
}

case "$MODE" in
  sync)
    [ -f "$SRC" ] || { printf 'Missing guidance source: %s\n' "$SRC" >&2; exit 1; }
    while IFS="$(printf '\t')" read -r dest surface; do
      [ -n "$dest" ] || continue
      link_guidance "$dest" "$surface"
    done <<< "$(guidance_destinations)"
    ;;
  uninstall)
    while IFS="$(printf '\t')" read -r dest surface; do
      [ -n "$dest" ] || continue
      unlink_guidance "$dest"
    done <<< "$(guidance_destinations)"
    ;;
  *)
    printf 'Usage: %s [sync|uninstall]\n' "$(basename "$0")" >&2
    exit 2
    ;;
esac
